rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    function validProduct() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'price', 'soluong', 'image'])
        && d.keys().hasOnly(['name', 'price', 'soluong', 'image'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 150
        && d.name.matches('.*[^ \t\r\n].*')
        && d.price is number && d.price >= 0 && d.price <= 1000000000000
        && d.soluong is int && d.soluong >= 0 && d.soluong <= 1000000000
        && d.image is string && d.image.size() <= 2048
        && d.image.matches('https?://[^ \t\r\n]+');
    }
    match /products/{productId} {
      allow read, delete: if admin();
      allow create, update: if admin() && validProduct();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
